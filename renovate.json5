{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],

  // Check for updates daily
  "schedule": ["at any time"],
  "prHourlyLimit": 5,
  "prConcurrentLimit": 0,  // no limit to number of PR's that can be open at the same time

  // Track Ghostfolio releases via the appVersion field and artifacthub.io/changes annotation in Chart.yaml
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track Ghostfolio GitHub releases in chart appVersion",
      "managerFilePatterns": ["chart/Chart.yaml"],
      "matchStrings": [
        "appVersion:\\s*\"?(?<currentValue>[\\d\\.]+)\"?"
      ],
      "depNameTemplate": "ghostfolio/ghostfolio",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v?(?<version>.*)$"
    }
  ],

  // Bump chart version when any dependency is updated
  "bumpVersions": [
    {
      "name": "Bump chart version on dependency update",
      "filePatterns": ["{{packageFileDir}}/Chart.yaml"],
      "matchStrings": ["\\nversion:\\s(?<version>[^\\s]+)"],
      "bumpType": "patch"
    }
  ],

  // Keep subchart archives in charts/ in sync
  "postUpdateOptions": ["helmUpdateSubChartArchives"],
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["cloudpirates/postgres"],
      "commitMessageTopic": "Helm chart {{depName}}",
    },
    {
      "description": "Non-breaking changes",
      "matchJsonata": ["isBreaking != true"],
      "addLabels": ["non-breaking"]
    },
    {
      description: "Breaking changes",
      matchJsonata: ["isBreaking = true"],
      addLabels: ["breaking"]
    }
  ],
  // The sync-changes-annotation workflow re-enables platform auto-merge after it
  // pushes the annotation update, since GitHub disables auto-merge when a non-Renovate
  // user pushes to the PR. PRs without the "non-breaking" label are still merged manually.
  "automerge": false,
  "labels": ["renovate"],
  "dependencyDashboardLabels": ["renovate"]
}
